# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Judge backends — at least one is required for solo debates, PvP judging,
# and daily topic generation. OpenRouter is primary; Anthropic is the
# ensemble's second judge when present.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional OpenRouter tuning. The default model is the free GLM 5.2
# (z-ai/glm-5.2:free). Its upstream pool is shared and rate-limits under load,
# so point OPENROUTER_MODEL at a paid model if you need reliable throughput.
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=

# Human-evaluation corpus pipeline: comma-separated admin emails allowed to
# import debates (/api/corpus/import), read reliability reports, and
# adjudicate disputed items. Leave unset to keep those endpoints closed.
CORPUS_ADMIN_EMAILS=
