# Standard Postgres connection string. A pooled Neon/Vercel Postgres URL is
# recommended for serverless deployments. Keep this server-only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Transactional password-reset email. RESEND_API_KEY is server-only.
# APP_BASE_URL must be the public origin used in reset links. On Vercel the
# production URL can be inferred, but setting the canonical URL is preferred.
RESEND_API_KEY=
PASSWORD_RESET_FROM=Daily Debate <accounts@example.com>
APP_BASE_URL=https://example.com

# AI backend — free-tier OpenAI-compatible APIs only, no paid provider. Every
# call (solo turns, PvP judging, topics) walks the keyed providers in this order,
# each with its own model chain, until one returns a valid answer:
#   UNOROUTER_API_KEY     free Nemotron chain (nemotron-3.5-lightning:free …)
#   GROQ_API_KEY          console.groq.com free tier (openai/gpt-oss-120b)
#   CEREBRAS_API_KEY      cloud.cerebras.ai free tier (gpt-oss-120b)
#   GEMINI_API_KEY        aistudio.google.com free tier (gemini-3.8-flash) —
#                         free-tier prompts may be used to train Google models
#   NVIDIA_API_KEY        build.nvidia.com free credits (Nemotron)
#   OPENROUTER_API_KEY    OpenRouter ":free" models (rate-limited; tried last)
# Set as many as you can: more providers = fewer "AI unavailable" errors when a
# free tier is rate-limited. With none set the app runs guest mode only.
# <LABEL>_DISABLED=1 removes a keyed provider without deleting its key.
UNOROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional per-provider model tuning. <LABEL>_MODEL sets the primary,
# <LABEL>_FALLBACK_MODELS a comma-separated failover chain (empty string pins
# a single model). Defaults live in src/lib/openrouter.ts and mirror
# scripts/lib/judge-providers.mjs. Free rosters change often — override here
# when a provider retires a default model.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=
UNOROUTER_MODEL=
GROQ_MODEL=
CEREBRAS_MODEL=
GEMINI_MODEL=

# Live 24-fixture judge validation reads the same provider keys — every
# configured provider runs the full pack and gets its own leaderboard row.
# The CI workflow fails fast when no key is set; do not run a gated benchmark
# with --allow-skip unless the key-less run is deliberate.

# Human-evaluation corpus pipeline: comma-separated admin emails allowed to
# import debates (/api/corpus/import), read reliability reports, and
# adjudicate disputed items. Leave unset to keep those endpoints closed.
CORPUS_ADMIN_EMAILS=

# Structural classifier (classifier.dev — keyless per-IP free tier, no secret).
# CLASSIFIER_DEV_ENDPOINT overrides the default https://classifier.dev/v1/classify.
# CLASSIFIER_SHADOW_SAMPLE_RATE (0..1, default 0.25) hash-samples judged PvP
# debates before any remote classifier call, cutting external traffic while
# keeping shadow-validation denominators unbiased. Unparseable values fall
# back to classifying every debate. Human-grounded corpus runs and live solo
# shaping are never sampled.
CLASSIFIER_DEV_ENDPOINT=
CLASSIFIER_SHADOW_SAMPLE_RATE=
