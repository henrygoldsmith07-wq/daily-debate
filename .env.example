# Standard Postgres connection string. A pooled Neon/Vercel Postgres URL is
# recommended for serverless deployments. Keep this server-only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Judge backends — at least one is required for solo debates, PvP judging,
# and daily topic generation. NVIDIA is primary when its key is present;
# OpenRouter free tier otherwise; Anthropic is the ensemble's second judge.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional NVIDIA tuning (direct build.nvidia.com transport). Default model
# is Nemotron 3 Ultra; failover defaults to Nemotron 3 Super on the same API.
NVIDIA_MODEL=
NVIDIA_FALLBACK_MODELS=

# Optional OpenRouter tuning. The default model is the free GLM 5.2
# (z-ai/glm-5.2:free). Its upstream pool is shared and frequently rate-limits,
# so requests fail over to OPENROUTER_FALLBACK_MODELS — a comma-separated list
# defaulting to the free Nemotron 3 Ultra then Super, both verified to produce
# a well-formed PvP argument graph. Set it to an empty string to disable
# failover and pin the app to one model.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=

# Human-evaluation corpus pipeline: comma-separated admin emails allowed to
# import debates (/api/corpus/import), read reliability reports, and
# adjudicate disputed items. Leave unset to keep those endpoints closed.
CORPUS_ADMIN_EMAILS=
