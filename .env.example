# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Judge backends — at least one is required for solo debates, PvP judging,
# and daily topic generation. Gemini is primary; Anthropic is the ensemble's
# second judge when present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Human-evaluation corpus pipeline: comma-separated admin emails allowed to
# import debates (/api/corpus/import), read reliability reports, and
# adjudicate disputed items. Leave unset to keep those endpoints closed.
CORPUS_ADMIN_EMAILS=
