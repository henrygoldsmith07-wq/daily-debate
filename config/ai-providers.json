{
  "$comment": "Single source of truth for the free-tier AI provider chain, read by the app (src/lib/openrouter.ts) and the scripts (scripts/lib/judge-providers.mjs: benchmark, topic generation, quota probe). Array order IS the priority order every call walks: measured-good, then unmeasured, then measured-bad (docs/latest-judge-benchmark.json). Re-measure before reordering. Every model is env-overridable with <LABEL>_MODEL / <LABEL>_FALLBACK_MODELS. reasoningToggle sends OpenRouter's reasoning:{enabled:false} extension (OpenRouter-style gateways only); extraBody is merged into each request (gpt-oss and Gemini Flash get low reasoning effort so thinking does not eat max_tokens).",
  "providers": [
    {
      "label": "unorouter",
      "keyEnv": "UNOROUTER_API_KEY",
      "url": "https://api.unorouter.com/v1/chat/completions",
      "defaultModel": "nemotron-3-super-120b-a12b:free",
      "fallbacks": ["nemotron-3-ultra-550b-a55b:free", "nemotron-3.5-lightning:free"],
      "reasoningToggle": true
    },
    {
      "label": "groq",
      "keyEnv": "GROQ_API_KEY",
      "url": "https://api.groq.com/openai/v1/chat/completions",
      "defaultModel": "openai/gpt-oss-120b",
      "fallbacks": ["openai/gpt-oss-20b"],
      "reasoningToggle": false,
      "extraBody": { "reasoning_effort": "low" }
    },
    {
      "label": "cerebras",
      "keyEnv": "CEREBRAS_API_KEY",
      "url": "https://api.cerebras.ai/v1/chat/completions",
      "defaultModel": "gpt-oss-120b",
      "fallbacks": [],
      "reasoningToggle": false,
      "extraBody": { "reasoning_effort": "low" }
    },
    {
      "label": "gemini",
      "keyEnv": "GEMINI_API_KEY",
      "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "defaultModel": "gemini-3.8-flash",
      "fallbacks": ["gemini-3.5-flash-lite"],
      "reasoningToggle": false,
      "extraBody": { "reasoning_effort": "low" }
    },
    {
      "label": "nvidia",
      "keyEnv": "NVIDIA_API_KEY",
      "url": "https://integrate.api.nvidia.com/v1/chat/completions",
      "defaultModel": "nvidia/nemotron-3-ultra-550b-a55b",
      "fallbacks": ["nvidia/nemotron-3-super-120b-a12b"],
      "reasoningToggle": true
    },
    {
      "label": "openrouter",
      "keyEnv": "OPENROUTER_API_KEY",
      "url": "https://openrouter.ai/api/v1/chat/completions",
      "defaultModel": "nvidia/nemotron-3-super-120b-a12b:free",
      "fallbacks": ["nvidia/nemotron-3.5-lightning:free", "nvidia/nemotron-3-ultra-550b-a55b:free"],
      "reasoningToggle": true
    }
  ]
}
